# FreshGlobal E-Commerce Environment Variables
# Copy this file to .env and fill in your actual values

# Database (for future backend integration)
DATABASE_URL=mongodb://localhost:27017/freshglobal
# OR for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/freshglobal

# API Configuration
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_STRIPE_PUBLIC_KEY=pk_test_your_stripe_key_here

# Email Service (for order confirmations)
SENDGRID_API_KEY=SG.your_sendgrid_key_here
EMAIL_FROM=noreply@freshglobal.com

# JWT Secret (for authentication)
JWT_SECRET=your_super_secret_jwt_key_here

# Admin Credentials
ADMIN_EMAIL=admin@freshglobal.com
ADMIN_PASSWORD=change_this_password

# Shipping API Keys
DHL_API_KEY=your_dhl_api_key
FEDEX_API_KEY=your_fedex_api_key

# Cloud Storage (for product images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
